<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AdMob-App-ID (echte MyPeak-Android-ID, Konto pub-8860791993288062) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8860791993288062~3613953701" />

        <!-- Health Connect: Begruendungs-Seite, die der Einwilligungsdialog
             verlinkt ("Warum will diese App das?"). Die Activity liefert das
             capacitor-health-Plugin mit; bis Android 13 direkt, ab 14 ueber
             den Alias. Ohne beide lehnt Health Connect die Anfrage ab. -->
        <activity
            android:name="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Homescreen-Widget (Streak / Woche / Level), s. FullRepWidget.java -->
        <receiver
            android:name=".FullRepWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fullrep_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kamera für Barcode-Scanner und Mahlzeiten-Fotos (getUserMedia im WebView) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Pausenende-Benachrichtigung des Rest-Timers (Android 13+ fragt zur
         Laufzeit; der Dialog kommt erst beim ersten Timer-Start, s.
         src/lib/restNotification.js). Das Plugin deklariert die Berechtigung
         auch selbst — doppelt schadet beim Manifest-Merge nicht, fehlend schon. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect (Opt-in im Profil, src/lib/health.js). NUR die drei
         Berechtigungen, die die App wirklich anfragt — Health Connect zeigt
         jede deklarierte Berechtigung im Einwilligungsdialog an, ungenutzte
         Eintraege verwirren dort nur. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <!-- ⚠ Genau die, die health.js auch wirklich abfragt (schritteHeute,
         gewichtImportieren, seit 1.6.2 verbrannteKcalHeute).
         READ_ACTIVE_CALORIES_BURNED stand hier bis 1.5.0
         mit, wurde aber nirgends gelesen: Google verlangt in der
         Health-Apps-Erklaerung fuer JEDE angeforderte Berechtigung eine
         Begruendung, und eine ungenutzte ist ein Ablehnungsgrund. Sie
         widersprach ausserdem der eigenen Datenschutzerklaerung, die nur
         Schritte und Gewicht nennt. Wer hier etwas hinzufuegt, muss beides
         nachziehen — Formular UND Datenschutztext. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <!-- Seit 1.6.2: aktive (verbrannte) Kalorien fuer Startseite und Widget
         (verbrannteKcalHeute in health.js). Begruendet im Play-Formular,
         genannt im Datenschutztext. -->
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- Seit 1.6.2: Schritte selbst zaehlen (SchrittePlugin.kt, Sensor
         TYPE_STEP_COUNTER). Laufzeitberechtigung ab Android 10, eigenes
         Opt-in im Profil. Kein Foreground-Service: ein WorkManager-Job liest
         den Zaehler alle 15 Minuten kurz aus. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Seit 1.6.0: Workouts nach Health Connect schreiben (HealthExportPlugin.kt),
         eigenes Opt-in im Profil. Nur Trainingseinheiten — Typ, Start, Ende,
         Titel. ⚠ Neue Berechtigung = neuer Eintrag im Play-Formular
         „Berechtigungen für Gesundheitsdaten" (erster Build von Hand in den
         internen Test, siehe CLAUDE.md) UND im Datenschutztext. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- ⚠⚠ NEUN BERECHTIGUNGEN, DIE WIR NIE ANGEFORDERT HABEN — vom Plugin.
         `capacitor-health` deklariert in seinem eigenen Manifest ELF
         Health-Berechtigungen (node_modules/capacitor-health/android/src/main/
         AndroidManifest.xml). Der Manifest-Merger nimmt sie ungefragt mit; im
         fertigen AAB stehen sie, obwohl oben nur zwei deklariert sind.

         Aufgefallen ist es erst in Googles Formular „Berechtigungen fuer
         Gesundheitsdaten": Dort standen 10 Felder statt 2, jedes mit
         Begruendungspflicht. Google verlangt fuer jede angeforderte
         Berechtigung einen genehmigten Anwendungsfall — neun davon haetten
         erfunden werden muessen, und das ist ein Ablehnungsgrund.

         ⚠ Das Formular erscheint ERST, wenn ein Bundle mit
         Health-Berechtigungen in einem Track liegt. Vorher hat die
         Health-Apps-Erklaerung nur zwei Schritte und wirkt vollstaendig —
         genau daran sind am 02.09. vier API-Laeufe gescheitert (403
         „You must let us know whether your app includes any health
         features"), waehrend die Console „Abgeschlossen" meldete. Henne und Ei:
         ohne Bundle kein Formular, ohne Formular kein Bundle. Aufloesen laesst
         es sich nur ueber die Oberflaeche, nicht ueber die API.

         `tools:node="remove"` wirft sie beim Zusammenfuehren wieder heraus.
         Wer eine davon wirklich braucht: Zeile loeschen, oben deklarieren,
         in health.js abfragen, im Play-Formular begruenden UND in der
         Datenschutzerklaerung ergaenzen — alle vier, sonst passt es nicht
         mehr zusammen. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" tools:node="remove" />
</manifest>
