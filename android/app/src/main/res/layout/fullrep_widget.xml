<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen-Widget: kcal uebrig / Protein / KH / Fett / Schritte / verbrannt
     nebeneinander, FullRep-Look: Schwarz mit Amber, Makrofarben wie in der App.
     RemoteViews kann kein CSS — Farben und Radius kommen aus dem
     drawable-Hintergrund. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fullrep_widget_grund"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_kcal_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FBBF24"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_kcal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_protein_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_protein" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_carbs_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_carbs" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_fat_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F43F5E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_fat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_schritte_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF8E7"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_schritte" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_verbrannt_wert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FB923C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="–" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A29E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="@string/widget_verbrannt" />
    </LinearLayout>
</LinearLayout>
