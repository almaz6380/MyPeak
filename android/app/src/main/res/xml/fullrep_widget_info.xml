<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 30 min = Android-Minimum. Der eigentliche Refresh
     kommt aus MainActivity.onPause() (frische Daten sofort nach App-Nutzung);
     der Periodik-Tick faengt nur den Fall ab, dass die App tagelang zu bleibt. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/fullrep_widget"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_beschreibung" />
