<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Muss dieselbe Gruppe tragen wie App/App.entitlements — fehlt eine der
	     beiden Seiten, liest das Widget stumm nichts (kein Fehler, nur Striche). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.at.gallab.mypeak</string>
	</array>
	<!-- Seit 1.6.1 liest das Schritte-Widget selbst aus HealthKit (mit der
	     Freigabe der App). Die HEALTHKIT-Faehigkeit an der Widget-Bundle-ID
	     schaltet ios-release.yml per scripts/ios-profile.py ein. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
