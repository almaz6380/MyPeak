<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Muss dieselbe Gruppe tragen wie App/App.entitlements — fehlt eine der
	     beiden Seiten, liest das Widget stumm nichts (kein Fehler, nur Striche). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.at.gallab.mypeak</string>
	</array>
</dict>
</plist>
